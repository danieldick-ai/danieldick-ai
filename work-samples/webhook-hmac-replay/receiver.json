    {
      "parameters": {
        "jsCode": "const { timingSafeEqual } = require('crypto');\n\nconst headers = $json.headers ?? {};\nconst body = $json.body ?? {};\n\nconst supplied = String(headers['x-portfolio-signature'] ?? '').trim().toLowerCase();\nconst computed = String($json.computed_signature ?? '').trim().toLowerCase();\n\nlet hmacOk = false;\nif (/^[0-9a-f]{64}$/.test(supplied) && /^[0-9a-f]{64}$/.test(computed)) {\n  const a = Buffer.from(supplied, 'hex');\n  const b = Buffer.from(computed, 'hex');\n  if (a.length === b.length) hmacOk = timingSafeEqual(a, b);\n}\n\nconst ts = Number(body._ts);\nconst now = Math.floor(Date.now() / 1000);\nconst ageSeconds = Number.isFinite(ts) ? Math.abs(now - ts) : null;\nconst timestampOk = Number.isInteger(ts) && ageSeconds <= 300;\n\nconst nonce = String(body._nonce ?? '').trim();\nconst nonceOk = /^[A-Za-z0-9._:-]{16,128}$/.test(nonce);\n\nconst reasons = [];\nif (!hmacOk) reasons.push('invalid_hmac');\nif (!timestampOk) reasons.push('timestamp_outside_300s_window');\nif (!nonceOk) reasons.push('invalid_nonce');\n\nreturn [{\n  json: {\n    headers,\n    body,\n    security: {\n      hmac_ok: hmacOk,\n      timestamp_ok: timestampOk,\n      nonce_ok: nonceOk,\n      age_seconds: ageSeconds,\n      nonce,\n      reasons\n    },\n    security_pass: (hmacOk && timestampOk && nonceOk) ? 1 : 0\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2288,
        592
      ],
      "name": "VERIFY - Signature + Timestamp",
      "id": "sample-1-node-3"
    },
    {
      "parameters": {
