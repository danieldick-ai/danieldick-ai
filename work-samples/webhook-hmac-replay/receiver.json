      "id": "sample-1-node-4"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH cleanup AS (\n  DELETE FROM portfolio_webhook_replay_guard\n  WHERE received_at < NOW() - INTERVAL '10 minutes'\n),\ninserted AS (\n  INSERT INTO portfolio_webhook_replay_guard (nonce, received_at)\n  VALUES ($1, NOW())\n  ON CONFLICT (nonce) DO NOTHING\n  RETURNING nonce\n)\nSELECT CASE WHEN EXISTS (SELECT 1 FROM inserted) THEN 1 ELSE 0 END AS replay_pass;",
        "options": {
          "queryReplacement": "={{ [ $('VERIFY - Signature + Timestamp').item.json.security.nonce ] }}"
        }
