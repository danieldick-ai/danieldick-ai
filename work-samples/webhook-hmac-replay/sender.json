            },
            {
              "id": "8f6691f1-2a5e-4a8e-9f5c-0be467fe7dfc",
              "name": "status",
              "value": "={{ $json.body?.status }}",
              "type": "string"
            },
            {
              "id": "c8fba0d6-a13b-4e55-b995-7abfdecf16da",
              "name": "ok",
              "value": "={{ $json.body?.ok }}",
              "type": "string"
            },
            {
              "id": "690a8a6e-3d78-4559-b6b2-265ab0f79b6e",
              "name": "body",
              "value": "={{ JSON.stringify($json.body) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
